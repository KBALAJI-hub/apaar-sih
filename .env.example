# ==============================================================================
# APAAR Verify Environment Configuration Template
# ==============================================================================

# Database Target Selection: sqlite (default local development) | supabase (remote cloud)
DB_TARGET=sqlite

# Local SQLite Database Path
LOCAL_DATABASE_URL=sqlite:///apaar.db

# Remote Supabase PostgreSQL (Required ONLY for maintainer snapshot export or remote integration testing)
# Example format: postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=

# Cryptographic Keys (Ed25519 Root Private Key Path)
ED25519_PRIVATE_KEY_PATH=aicte_ed25519_private.pem

# Safety Guards (Keep false for normal operation)
ALLOW_RESET_DB=false
ALLOW_POSTGRES_TEST=false
