# Supabase PostgreSQL Database (Authoritative Database)
# Format: postgresql://postgres.<project_ref>:<password>@<pooler_host>:5432/postgres
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Cryptographic Keys (Ed25519 Root Private Key Path)
ED25519_PRIVATE_KEY_PATH=aicte_ed25519_private.pem

# Safety Guards (Keep false for normal operation)
ALLOW_RESET_DB=false
